# Copy to .env (never commit .env). .env is gitignored.
LLM_PROVIDER=groq                 # groq | ollama | openai | anthropic
LLM_MODEL=openai/gpt-oss-120b     # Groq-served reasoning model

# Groq keys. Add as many as you like, comma-separated; the client rotates
# them round-robin and advances on rate-limit (HTTP 429). Free keys:
# https://console.groq.com
GROQ_API_KEYS=key1,key2
# Alternatives also accepted: GROQ_API_KEY_1=... GROQ_API_KEY_2=... or GROQ_API_KEY=...

# Offline fallback: set LLM_PROVIDER=ollama and run `ollama serve`
# OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
